# Obrigatório: raiz da instalação do OpenMonetis.
# Produção (via proxy same-origin do web): https://financas.exemplo.com/api-proxy
# Desenvolvimento (API direta): http://localhost:7001
# Em container falando com o host: http://host.docker.internal:7002/api-proxy
OPENMONETIS_URL=http://localhost:7001

# Autenticação recomendada: a sessão Better Auth é aberta no start e renovada em 401.
OPENMONETIS_EMAIL=
OPENMONETIS_PASSWORD=

# Alternativa: cole o header Cookie de uma sessão já autenticada.
# Expira junto com a sessão (AUTH_SESSION_EXPIRES_IN_DAYS) e não renova sozinho.
OPENMONETIS_COOKIE=

# Origin enviado no login. O Better Auth exige um valor presente em trustedOrigins.
# Padrão: a origem de OPENMONETIS_URL (correto quando OPENMONETIS_URL termina em /api-proxy).
# Ao falar direto com a API em dev, use a origem do web: OPENMONETIS_ORIGIN=http://localhost:7002
OPENMONETIS_ORIGIN=

# read-only | confirm (padrão) | full
OPENMONETIS_MCP_WRITES=confirm

# Timeout de cada chamada à API, em milissegundos.
OPENMONETIS_TIMEOUT_MS=20000

# Teto em bytes do JSON devolvido por uma ferramenta. Acima disso, a maior lista
# é cortada e marcada com { truncated: true, returned, available }. 0 desliga.
OPENMONETIS_MCP_MAX_RESPONSE_BYTES=65536

# Cache em memória para leituras (GET). GETs idênticos dentro do TTL reaproveitam
# a resposta; chamadas concorrentes compartilham a mesma requisição. Escritas
# invalidam o cache do recurso alterado. 0 desliga o cache.
OPENMONETIS_MCP_CACHE_TTL_MS=30000

# Tentativas extras em leituras quando a API responde 429/500/502/503/504 ou há
# erro de rede. Escritas nunca são repetidas. 0 desliga; máximo 5.
OPENMONETIS_MCP_RETRY_ATTEMPTS=2

# Perfil do catálogo: full (75 ferramentas, padrão) ou core (14 de leitura
# essencial, para agentes com orçamento de contexto apertado).
OPENMONETIS_MCP_TOOLS=full

# 1 = loga uma linha JSONL por chamada de ferramenta em stderr (tool, ms, bytes, ok).
OPENMONETIS_MCP_DEBUG=

# Diretório local onde exportações (CSV/XLSX), modelo de importação e
# uploads temporários são gravados. Padrão: ~/Downloads/openmonetis-mcp
OPENMONETIS_EXPORT_DIR=

# Cofre de credenciais (alternativa a OPENMONETIS_EMAIL/PASSWORD).
# Preencha com `openmonetis-mcp auth set` e deixe as variáveis acima vazias.
# Backend: keychain | secret-tool | file | none
OPENMONETIS_CREDENTIAL_STORE=
# Diretório do cofre quando o backend é arquivo. Padrão: ~/.config/openmonetis-mcp
OPENMONETIS_CONFIG_DIR=

# Permite OPENMONETIS_URL http:// para hosts não loopback (necessário para
# host.docker.internal). Evite em produção.
OPENMONETIS_ALLOW_INSECURE=

# Transporte HTTP (openmonetis-mcp-http)
OPENMONETIS_MCP_HTTP_HOST=127.0.0.1
OPENMONETIS_MCP_HTTP_PORT=7317
# Obrigatório quando o host não é loopback.
MCP_HTTP_TOKEN=
